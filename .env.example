# Claude Agent SDK / Claude Code credentials are read by the SDK/CLI.
ANTHROPIC_API_KEY=

# Development project workspace. Use a real checkout or a dedicated dev branch.
MVP_WORKSPACE=/absolute/path/to/cockpit-dev-repo

# MCP endpoints. Leave blank only when that integration is not needed for a run.
GIT_MCP_URL=http://localhost:8001/mcp
GIT_MCP_AUTH_TOKEN=
JIRA_MCP_URL=http://localhost:8002/mcp
JIRA_MCP_AUTH_TOKEN=
CI_MCP_URL=http://localhost:8003/mcp
CI_MCP_AUTH_TOKEN=

# Local development storage
RUN_STORE_PATH=.data/runs
GIT_MCP_TRANSPORT=http
JIRA_MCP_TRANSPORT=http
CI_MCP_TRANSPORT=http
MODEL=
MAX_TURNS=20
MAX_BUDGET_USD=
PLUGIN_PATHS=
